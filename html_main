// NOTE: Shoplive 캠페인 모달 자동 실행 (_sl_ck 파라미터)
(function() {
    // NOTE: URL에서 _sl_ck 파라미터 추출
    var urlParams = new URLSearchParams(window.location.search);
    var campaignKey = urlParams.get('_sl_ck');
    
    // NOTE: 파라미터가 존재하면 Shoplive 모달 실행
    if (campaignKey && typeof cloud !== 'undefined' && cloud.shoplive) {
        // NOTE: Shoplive SDK가 완전히 로드될 때까지 대기
        var checkShoplive = setInterval(function() {
            if (cloud.shoplive.showFeaturedPlayerModal) {
                clearInterval(checkShoplive);
                cloud.shoplive.showFeaturedPlayerModal({
                    campaignKey: campaignKey
                });
            }
        }, 100);
        
        // NOTE: 최대 5초 대기 후 타임아웃
        setTimeout(function() {
            clearInterval(checkShoplive);
        }, 5000);
    }
})();
